{
  "name": "@tvbl/jupyterlite-mcp-hub",
  "version": "0.1.0",
  "description": "Connect a JupyterLite notebook to an MCP hub (browser runner side)",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "files": [
    "lib/**/*.{js,js.map,d.ts}",
    "style/**/*",
    "schema/**/*"
  ],
  "scripts": {
    "build:lib": "tsc",
    "build:labextension": "jupyter labextension build .",
    "build": "jlpm build:lib && jlpm build:labextension",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@jupyterlab/application": "4.6.5",
    "@jupyterlab/apputils": "4.6.5",
    "@jupyterlab/cells": "4.6.5",
    "@jupyterlab/coreutils": "6.6.5",
    "@jupyterlab/docmanager": "4.6.5",
    "@jupyterlab/notebook": "4.6.5",
    "@jupyterlab/services": "7.6.5",
    "@jupyterlab/settingregistry": "4.6.5",
    "@jupyterlab/statusbar": "4.6.5",
    "@jupyterlab/translation": "4.6.5",
    "@lumino/signaling": "^2.1.3",
    "@lumino/widgets": "^2.7.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.11",
    "rimraf": "^5.0.10",
    "typescript": "~5.6.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "../extensions/@tvbl/jupyterlite-mcp-hub",
    "schemaDir": "schema"
  }
}
